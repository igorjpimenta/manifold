{
  "name": "@igorjpimenta/manifold-openclaw",
  "version": "2026.11.26-beta.2",
  "description": "OpenClaw companion for manifold: spawns and supervises `manifold serve`, bridges agent and discuss turns into the engine, and exposes manifold's pipeline tools over MCP.",
  "exports": {
    ".": "./index.js"
  },
  "license": "MIT",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorjpimenta/manifold.git"
  },
  "files": [
    "README.md",
    "gateway-readiness.js",
    "index.js",
    "meta.js",
    "openclaw.plugin.json",
    "run-turn.js",
    "session-keys.js",
    "sessions.js",
    "telemetry.js"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "openclawMin": "2026.5.6"
    }
  },
  "dependencies": {
    "@igorjpimenta/manifold": "^2026.11.26-beta.2"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
