  },
  "files": [
    "README.md",
    "index.js",
    "meta.js",
    "openclaw.plugin.json",
    "run-turn.js",
    "session-keys.js",
    "sessions.js"
  ],
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "openclawMin": "2026.5.6"
    }
  },
  "dependencies": {
    "@igorjpimenta/manifold": "^2026.10.26-beta.1"
  },
  "scripts": {
