    "type": "git",
    "url": "git+https://github.com/igorjpimenta/manifold.git"
  },
  "openclaw": {
    "extensions": [
      "./index.js"
    ],
    "compat": {
      "openclawMin": "2026.5.6"
    }
  },
  "dependencies": {
    "@igorjpimenta/manifold": "^2026.11.27-beta.1"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  }
}
