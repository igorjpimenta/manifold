{
  "name": "@igorjpimenta/manifold",
  "version": "2026.11.22-beta.2",
  "license": "UNLICENSED",
  "description": "LangGraph-style pipeline executor for openclaw. Loads workspace/.pipelines/<team>_<name>.js definitions and runs them against managed flow_runs, dispatching nodes to agents via runtime.subagent.run with explicit state-graph routing.",
  "type": "module",
  "exports": {
    ".": "./index.js",
    "./elevation": "./elevation.js",
    "./errors": "./engine/executor-errors.js",
    "./package.json": "./package.json",
    "./routes/bearer-auth": "./routes/bearer-auth.js",
    "./state/batch-writer": "./state/batch-writer.js",
    "./state/db": "./state/db.js",
    "./state/paths": "./state/paths.js",
    "./state/schema": "./state/schema.js",
    "./tool-handoff": "./state/tool-handoff.js"
  },
  "scripts": {
    "prepare": "env -u npm_config_allow_scripts npm --prefix dashboard ci --no-audit --no-fund && npm --prefix dashboard run build",
    "test": "./scripts/with-guard.sh node --experimental-test-module-mocks --test-timeout=60000 --test 'test/**/*.test.js'",
    "test:unit": "./scripts/with-guard.sh node --experimental-test-module-mocks --test-timeout=60000 --test 'test/unit/**/*.test.js'",
    "test:integration": "./scripts/with-guard.sh node --test-timeout=60000 --test 'test/integration/*.test.js'",
    "db:generate": "drizzle-kit generate --config=drizzle.config.js && drizzle-kit generate --config=drizzle.config.ops.js",
    "db:migrate": "drizzle-kit migrate --config=drizzle.config.js && drizzle-kit migrate --config=drizzle.config.ops.js",
    "postinstall": "node scripts/link-core-self.mjs"
  },
  "dependencies": {
    "@igorjpimenta/oc-contracts": "git+https://github.com/igorjpimenta/oc-contracts.git#v1.0.1",
    "@libsql/client": "^0.17.4",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.3",
    "drizzle-orm": "^0.45.2",
    "graphql": "^16.14.2",
    "zod": "^3.25 || ^4.0"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  },
  "bin": {
    "manifold": "bin/manifold.js"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/igorjpimenta/manifold.git"
  }
}
