# Pack rules, not git rules: npm pack falls back to .gitignore only when no
# .npmignore exists, and .gitignore's `dist/` rule would strip the
# prepare-built dashboard/dist — the artifact git-dependency installs
# (this package's only distribution channel) depend on receiving. Mirrors
# .gitignore minus `dist/`; keep the two lists in sync except for that rule.
node_modules
.doppler/
.citmp/
*.log
.DS_Store
*.local
.vite
tsconfig.tsbuildinfo
