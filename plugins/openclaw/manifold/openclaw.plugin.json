{
  "id": "manifold",
  "enabledByDefault": true,
  "activation": {
    "onStartup": true,
    "onConfigPaths": [
      "plugins.entries.manifold"
    ]
  },
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "apiPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65535
      },
      "coreBinary": {
        "type": "string"
      },
      "dashboardEnabled": {
        "type": "boolean"
      },
      "dashboardHost": {
        "type": "string"
      },
      "dashboardPort": {
        "type": "integer",
        "minimum": 1024,
        "maximum": 65535
      },
      "discuss": {
        "type": "object",
        "description": "Discuss defaults. Used when a blocked gate node does not declare its own discuss.agent.",
        "additionalProperties": false,
        "properties": {
          "defaultAgent": {
            "type": "string",
            "description": "Default agent for gate discuss sessions. Used when the blocked gate node does not declare its own discuss.agent."
          }
        }
      },
      "globalConcurrency": {
        "type": "integer",
        "minimum": 1,
        "description": "Shared ceiling for every flow-run concurrency mechanism \u2014 agent dispatch, subflow fan-out, and whole-flow-run concurrency alike (engine/global-concurrency.js). Default: 8."
      },
      "ownerSessionKey": {
        "type": "string"
      },
      "pipelinesDir": {
        "type": "string"
      },
      "turnUrl": {
        "type": "string"
      }
    }
  }
}
